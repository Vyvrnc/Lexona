#!/bin/bash
# lexona-unlimit: turns Android's child process limit off from the phone itself, over Wireless
# debugging (adb to 127.0.0.1), without a computer. Lexona's warning opens it in a terminal.
#   lexona-unlimit          turn the limit off
#   lexona-unlimit --undo   put Android's default back
# Needs Developer options and Wi-Fi (Wireless debugging only runs on Wi-Fi). Sets the same three
# values as the adb commands from a computer; they survive a reboot.
set -u
undo=0
[ "${1:-}" = --undo ] && undo=1
marker=$HOME/.config/lexona/phantom-unlocked

say() { printf '\n%s\n' "$*"; }
finish() {
    say "$1"
    read -r -p "Press Enter to close. " _ || true
    exit "${2:-0}"
}

if ! command -v adb >/dev/null 2>&1; then
    say "Installing adb (package android-tools)..."
    pkg install -y android-tools < /dev/null || finish "Installing adb failed; check the internet connection." 1
fi

# The adb server it starts is one more process: end it on the way out.
trap 'adb kill-server >/dev/null 2>&1' EXIT
try_connect() {  # try_connect PORT: connected and authorized (paired before)
    dev=127.0.0.1:$1
    adb connect "$dev" < /dev/null >/dev/null 2>&1
    [ "$(adb -s "$dev" get-state < /dev/null 2>/dev/null)" = device ]
}

if [ $undo = 1 ]; then
    say "Put Android's child process limit back (no computer needed)"
else
    say "Turn the child process limit off without a computer"
fi
cat <<'EOF'

1. Settings > Developer options > Wireless debugging: turn it on (the phone must be on Wi-Fi).
   Developer options appear after tapping Build number 7 times (Settings > About phone >
   Software information). Its main screen shows "IP address & Port".
EOF
# Termux's adb has no mDNS, so the port is typed; a phone paired before needs nothing else.
read -r -p "Port (the number after the colon in \"IP address & Port\"): " cport || exit 1
if try_connect "$cport"; then
    say "Connected (this phone was paired before)."
else
    cat <<'EOF'

2. Not paired yet. Put Settings and Lexona side by side (split screen or a pop-up window); the
   pairing code closes when you switch apps.
3. In Wireless debugging tap "Pair device with pairing code".
EOF
    read -r -p "Pairing port (the number after the colon in the pairing window): " pport || exit 1
    read -r -p "Pairing code (6 digits): " pcode || exit 1
    adb pair "127.0.0.1:$pport" "$pcode" < /dev/null || finish "Pairing failed. Check the port and the code and run lexona-unlimit again." 1
    try_connect "$cport" || finish "Paired, but could not connect to 127.0.0.1:$cport. Check the port under \"IP address & Port\"." 1
fi
sh_() { adb -s "$dev" shell "$@" < /dev/null | tr -d '\r'; }

if [ $undo = 1 ]; then
    sh_ settings delete global settings_enable_monitor_phantom_procs >/dev/null
    sh_ device_config delete activity_manager max_phantom_processes >/dev/null
    sh_ device_config set_sync_disabled_for_tests none >/dev/null
    adb disconnect "$dev" >/dev/null 2>&1
    rm -f "$marker"
    finish "Android's default is back (the 32-process limit applies). You can turn Wireless debugging off."
fi

sh_ settings put global settings_enable_monitor_phantom_procs false >/dev/null
sh_ device_config set_sync_disabled_for_tests persistent >/dev/null
sh_ device_config put activity_manager max_phantom_processes 2147483647 >/dev/null
max=$(sh_ device_config get activity_manager max_phantom_processes)
mon=$(sh_ settings get global settings_enable_monitor_phantom_procs)
adb disconnect "$dev" >/dev/null 2>&1

if [ "$max" = 2147483647 ] && [ "$mon" = false ]; then
    mkdir -p "${marker%/*}" && date '+%F %T' > "$marker"
    finish "Done: Android no longer stops Linux programs because of their number (survives a reboot).
You can turn Wireless debugging off now. To undo: lexona-unlimit --undo"
fi
finish "The settings did not stick (max_phantom_processes=$max, monitor=$mon). Try again, or from a computer." 1
