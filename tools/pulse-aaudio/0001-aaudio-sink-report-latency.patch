     struct userdata* u = PA_SINK(o)->userdata;
 
     pa_assert(u);
 
     switch (code) {
+        case PA_SINK_MESSAGE_GET_LATENCY:
+            /* The stream is closed while the sink is suspended. */
+            *((int64_t *) data) = PA_SINK_IS_OPENED(u->sink->thread_info.state) ? (int64_t) stream_latency(u) : 0;
+            return 0;
         case SINK_MESSAGE_RENDER:
             return process_render(u, data, offset);
         case SINK_MESSAGE_OPEN_STREAM:
@@ -369,7 +397,8 @@
